# Opción simple para SQLite o una URL SQLAlchemy completa.
DATABASE_URL=sqlite:///./business.db

# Conexión a MySQL. Al definir DB_HOST, estas variables tienen prioridad sobre DATABASE_URL.
DB_HOST=
DB_USER=
DB_PASS=
DB_PORT=3306
DB_NAME=business

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
