# Opción simple para SQLite o una URL SQLAlchemy completa.
DATABASE_URL=sqlite:///./business.db

# Conexión a MySQL. Al definir DB_HOST, estas variables tienen prioridad sobre DATABASE_URL.
DB_HOST=
DB_USER=
DB_PASS=
DB_PORT=3306
DB_NAME=business

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# Servidor local de desarrollo (`.venv\Scripts\python dev.py`).
# No cambian el puerto interno ni el puerto publicado por Docker Compose.
DEV_HOST=0.0.0.0
DEV_PORT=4159

# URL interna que los bots Chromium usarán para acceder a esta misma API.
BOT_API_URL=http://127.0.0.1:4159
